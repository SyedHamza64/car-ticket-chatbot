# -----------------------------------------------------------------------------
# LaCuraDellAuto AI - Environment Configuration
# Copy to .env and fill in your values
# -----------------------------------------------------------------------------

# ----- Authentication (required for VPS / hosted deployment) -----
# Username for login
AUTH_USERNAME=admin

# Password hash - generate with: python scripts/generate_password_hash.py "YourPassword"
# Then paste the output here (no quotes around the hash)
AUTH_PASSWORD_HASH=

# Optional: Display name in sidebar (defaults to username)
# AUTH_DISPLAY_NAME=Administrator

# ----- AI Providers -----
# Groq API key (for Groq cloud models)
GROQ_API_KEY=

# Google API key (for Gemini)
GOOGLE_API_KEY=

# ----- Other -----
# ChromaDB will use ./chroma_db by default (see config/settings.py)
# USE_CUDA=true  # Uncomment to enable GPU for embeddings
